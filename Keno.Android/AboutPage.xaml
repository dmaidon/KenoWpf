<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Keno.Android.AboutPage"
             BackgroundColor="#F0F0F0">

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <!-- Row 0: Header -->
        <Grid ColumnDefinitions="*,Auto"
              BackgroundColor="#2196A6"
              Padding="12,8,4,8">
            <Label Text="ABOUT"
                   FontSize="16" FontAttributes="Bold" TextColor="White"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    x:Name="BtnClose"
                    Text="✕"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    TextColor="White"
                    FontSize="18" FontAttributes="Bold"
                    WidthRequest="46" HeightRequest="46"
                    Padding="0"
                    Clicked="BtnClose_Clicked" />
        </Grid>

        <!-- Row 1: Details -->
        <VerticalStackLayout Grid.Row="1" Spacing="10" Padding="24,32">
            <Label Text="Keno"
                   FontSize="32" FontAttributes="Bold" TextColor="#2196A6"
                   HorizontalOptions="Center" />
            <Label x:Name="LblVersion"
                   FontSize="18" FontAttributes="Bold" TextColor="#333333"
                   HorizontalOptions="Center" />
            <Label x:Name="LblCopyright"
                   FontSize="12" TextColor="#666666"
                   HorizontalOptions="Center" />
            <Label Text="Author: Dennis N Maidon"
                   FontSize="12" TextColor="#666666"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
